# NO KEY NEEDED. With no keys the app runs fully offline with its built-in coach.
# To add AI, put one or more keys below. Providers are tried in LEVELS: level 1 first;
# if it is overloaded, rate-limited or down, the request moves to level 2, then level 3...

GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
# xAI Grok (GROK_API_KEY also works):
XAI_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=

# Choose the order (levels). Example: Gemini first, then Grok, then OpenAI:
# LLM_CHAIN=gemini,xai,openai
# If you leave this out, the order is: gemini, anthropic, openai, groq, xai, openrouter, nvidia
# (only providers that have a key are used). LLM_PROVIDER=groq just puts that one first.
# For a free local model with no key, add "ollama" to the chain, e.g. LLM_CHAIN=gemini,ollama

# Optional: pick a model per provider (names change over time, copy one from the provider's model list)
# GEMINI_MODEL=gemini-3.8-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# XAI_MODEL=grok-3-mini
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# OLLAMA_MODEL=llama3.2

# Camera and screen images are only sent to levels that can read them: Gemini, Claude and OpenAI always;
# others only if you set e.g. GROQ_VISION=1 or XAI_VISION=1 (use a vision model for that provider).
# Custom OpenAI-compatible server (LM Studio etc.): OPENAI_BASE_URL=http://localhost:1234/v1
